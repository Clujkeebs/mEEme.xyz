# Railway sets NODE_ENV=production, and npm then omits devDependencies from
# `npm ci`. This build needs them: typescript (Next only reads the "@/*" path
# aliases when the typescript package is resolvable — without it every "@/"
# import fails to resolve), tailwindcss/postcss/autoprefixer for the CSS
# pipeline, and eslint + eslint-config-next because next.config.js sets
# eslint.ignoreDuringBuilds: false.
#
# This was latent for a long time, masked by a warm BuildKit cache holding an
# npm-ci layer from before NODE_ENV was set. When that cache was evicted the
# real install ran and every build broke at once.
include=dev
