// mEEme.xyz schema.
//
// Deliberately portable: no enums, no native arrays, no Json columns. Those are
// Postgres-only, and the whole point is that `DATABASE_URL=file:./dev.db` runs
// the same schema locally that Postgres runs in production. Structured values
// are stored as JSON strings and parsed at the edge of the DB layer.
// scripts/setup.sh rewrites the provider below to match your DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ——— auth (NextAuth) ———

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // "FREE" | "DEGEN" | "APEX"
  tier               String    @default("FREE")
  /// bcrypt hash. Null for accounts that only ever signed in with Google.
  passwordHash       String?
  stripeCustomerId   String?   @unique
  stripeSubId        String?   @unique
  // "active" | "trialing" | "past_due" | "canceled" | "incomplete"
  stripeStatus       String?
  subscriptionEndsAt DateTime?

  // Referral loop: every user gets a code, every share carries it.
  referralCode   String  @unique @default(cuid())
  referredByCode String?

  // ── Promo trials ──────────────────────────────────────────────────────────
  // Set by redeeming a PromoCode (lib/promo.ts). This alone does not grant
  // access — lib/tiers.ts effectiveTier() is what actually governs it, and it
  // is written so a trial can only ever add access on top of `tier`, never
  // take it away: a real Apex subscriber redeeming a Degen trial code stays
  // Apex, and the trial simply expires unused.
  trialTier   String?
  trialEndsAt DateTime?

  promoRedemption PromoRedemption?

  // ── Alert delivery ────────────────────────────────────────────────────────
  // An alert that only exists in a database is not an alert. Telegram is where
  // this audience already is, so it is the primary channel; email is the fallback.
  telegramChatId   String?  @unique
  telegramUsername String?
  /// Short-lived code the user carries into the bot via a deep link.
  telegramLinkCode String?  @unique
  notifyTelegram   Boolean  @default(true)
  notifyEmail      Boolean  @default(false)
  /// Quiet hours, UTC hour 0-23. When both are set, alerts inside the window are held.
  quietFromHourUtc Int?
  quietToHourUtc   Int?

  accounts  Account[]
  sessions  Session[]
  positions Position[]
  watches   Watch[]
  signals   Signal[]
  usage     UsageDay[]
  alerts    Alert[]
  apiKeys   ApiKey[]

  affiliateReferral AffiliateReferral?

  @@index([referredByCode])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ——— trading ———

/// A token the user actually holds. Drives the ladder and the exit alerts.
model Position {
  id            String   @id @default(cuid())
  userId        String
  tokenAddress  String
  chain         String   @default("solana")
  symbol        String
  /// Token units held.
  size          Float
  /// USD cost per token.
  entryPriceUsd Float
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  /// Realized USD PnL once closed.
  realizedPnlUsd Float?
  notes         String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@index([userId, closedAt])
  @@index([tokenAddress])
}

/// A token under active surveillance, held or not.
model Watch {
  id           String   @id @default(cuid())
  userId       String
  tokenAddress String
  chain        String   @default("solana")
  symbol       String
  createdAt    DateTime @default(now())
  /// Fire an alert when the coil score crosses this.
  coilThreshold Float   @default(0.68)
  /// Last coil score seen by the sweep, so we alert on crossings, not levels.
  lastCoilScore Float?
  lastSweptAt   DateTime?
  active        Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenAddress])
  @@index([active, lastSweptAt])
}

/// Every call the engine has ever made. Immutable. This is the track record.
model Signal {
  id           String   @id @default(cuid())
  userId       String?
  tokenAddress String
  chain        String   @default("solana")
  symbol       String
  createdAt    DateTime @default(now())

  verdict     String
  conviction  Float
  coilScore   Float
  confidence  Float
  headline    String

  coiledSupply         Float
  trappedSupply        Float
  insiderCoil          Float
  insiderRealized      Float
  velocityOfRealization Float

  priceAtSignal Float
  trapdoorUsd   Float?
  ceilingUsd    Float?
  halfLifeMin   Int    @default(15)

  /// JSON: string[] of reasoning lines.
  reasoningJson String
  /// JSON: ExitLadder, or null.
  ladderJson    String?
  /// True for demo-mode reads. Excluded from the public track record, always.
  synthetic     Boolean @default(false)
  /// Public share slug for the Exit Card.
  shareSlug     String  @unique @default(cuid())

  outcome SignalOutcome?
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tokenAddress, createdAt])
  @@index([userId, createdAt])
  @@index([synthetic, createdAt])
}

/// Resolved after the fact by the scoring cron. Scored against a rule fixed in
/// code before the call was made — see lib/scoring.ts.
model SignalOutcome {
  id       String @id @default(cuid())
  signalId String @unique

  price15m  Float?
  price1h   Float?
  price4h   Float?
  price24h  Float?

  /// Best/worst price seen inside the 24h window — did the ladder actually fill?
  maxPrice24h Float?
  minPrice24h Float?

  /// "correct" | "incorrect" | "neutral" | "pending"
  grade      String   @default("pending")
  /// Return the call would have produced, as a fraction. Signed for direction.
  edgePct    Float?
  resolvedAt DateTime?
  updatedAt  DateTime @updatedAt

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([grade, resolvedAt])
}

/// Fired when a watch crosses its threshold, or a position hits a rung/stop.
model Alert {
  id           String   @id @default(cuid())
  userId       String
  positionId   String?
  tokenAddress String
  symbol       String
  /// "COIL_CROSS" | "RUNG_HIT" | "STOP_HIT" | "INSIDER_DUMP"
  kind         String
  message      String
  priceUsd     Float
  createdAt    DateTime @default(now())
  readAt       DateTime?

  /// Set once the alert has actually left the building. Null means undelivered,
  /// which is what the delivery sweep looks for — so a failed send is retried
  /// rather than silently lost.
  deliveredAt   DateTime?
  /// Comma-separated channels that accepted it, e.g. "telegram,email".
  deliveredVia  String?
  deliveryError String?
  attempts      Int       @default(0)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([deliveredAt, attempts])
  // Without this, closing a position (onDelete: SetNull above) makes Postgres
  // scan every Alert row to find the ones pointing at it. Flagged by Supabase's
  // own advisor as an unindexed foreign key.
  @@index([positionId])
}

/// Daily quota ledger. One row per user per UTC day.
model UsageDay {
  id       String @id @default(cuid())
  userId   String
  /// UTC date, "YYYY-MM-DD".
  day      String
  locks    Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

/// Snapshot cache. Upstream APIs are rate-limited and slow; the engine is not.
model TokenCache {
  tokenAddress String   @id
  chain        String   @default("solana")
  symbol       String
  /// JSON: TokenSnapshot.
  snapshotJson String
  priceUsd     Float
  fetchedAt    DateTime @default(now())
  /// Seconds this entry stays fresh — short for young tokens, long for settled ones.
  ttlSeconds   Int      @default(60)

  @@index([fetchedAt])
}

/// Idempotency for Stripe. Webhooks are delivered at least once, not exactly once.
model ProcessedWebhook {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// Anonymous rate limiting, keyed by a salted hash of the caller's IP.
/// Lets a first-time visitor run real Target Locks before signing up — the
/// product has to sell itself — without opening an unbounded abuse surface.
model AnonUsage {
  id     String @id @default(cuid())
  ipHash String
  /// UTC date, "YYYY-MM-DD".
  day    String
  locks  Int    @default(0)

  @@unique([ipHash, day])
}

/// A code that grants a time-boxed trial of a paid tier. Created by an admin
/// (see /admin/promo), not by users. This is deliberately not a discount or a
/// Stripe coupon — it grants access directly, so a "3 days of Degen free" code
/// works with zero card entry, which is the point of a prelaunch code: remove
/// every point of friction between a link and someone actually using the paid
/// features.
model PromoCode {
  id             String    @id @default(cuid())
  /// Always stored upper-cased; redemption compares case-insensitively.
  code           String    @unique
  /// "DEGEN" | "APEX" — the tier granted while the trial is active.
  trialTier      String
  trialDays      Int
  /// Null = unlimited redemptions.
  maxRedemptions Int?
  active         Boolean   @default(true)
  expiresAt      DateTime?
  /// Internal context for whoever is reading the admin list later, e.g.
  /// "prelaunch marketing push, Aug 2026". Never shown to redeemers.
  note           String?
  createdByEmail String?
  createdAt      DateTime  @default(now())

  redemptions PromoRedemption[]

  @@index([active])
}

/// One row per user, ever — a user gets exactly one trial in their lifetime,
/// which is what stops a promo code from being stacked or replayed.
model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([promoCodeId])
}

/// A revenue-share partner. Deliberately not a User: an affiliate is not
/// necessarily a mEEme customer themselves, so there is nothing to attach
/// this to until they sign up. Dashboard access (see /affiliate) is granted
/// by matching the signed-in viewer's email against `email` here — the same
/// allowlist pattern ADMIN_EMAILS/isAdmin already uses for admin access, just
/// stored in the database instead of an env var because there can be many
/// affiliates and only ever one admin list.
model Affiliate {
  id            String   @id @default(cuid())
  /// Always stored upper-cased; shareable as meeme.xyz/?ref=CODE.
  code          String   @unique
  email         String   @unique
  name          String?
  /// Percent of each referred subscriber's invoice total, for 12 months from
  /// that subscriber's first paid invoice — not from their signup date.
  commissionPct Float    @default(30)
  active        Boolean  @default(true)
  note          String?
  createdAt     DateTime @default(now())

  referrals AffiliateReferral[]

  @@index([active])
}

/// One row per referred user, ever — first code seen wins, enforced by the
/// unique constraint on userId, the same shape as PromoRedemption.
model AffiliateReferral {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  /// Set on the first commission-eligible (nonzero) invoice — the 12-month
  /// commission window runs from here, not from `createdAt`.
  firstPaidAt DateTime?

  commissions AffiliateCommission[]

  @@index([affiliateId])
}

/// One row per commission-eligible Stripe invoice payment. `stripeInvoiceId`
/// is the idempotency key: Stripe delivers webhooks at least once, not
/// exactly once, and the unique constraint is what actually stops a retried
/// invoice.paid event from paying the same commission twice — the same
/// reasoning as ProcessedWebhook, just scoped to one invoice instead of one
/// event delivery.
model AffiliateCommission {
  id              String            @id @default(cuid())
  referralId      String
  referral        AffiliateReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  affiliateId     String
  stripeInvoiceId String            @unique
  amountUsd       Float
  commissionUsd   Float
  /// Toggled from /admin/affiliates once the affiliate has actually been
  /// paid — earned and paid are different questions, and this app has no
  /// payment rail to pay them itself.
  paidOut         Boolean           @default(false)
  createdAt       DateTime          @default(now())

  @@index([affiliateId, createdAt])
}

/// API keys for the Apex tier.
///
/// Only the hash is stored — a database dump must not hand someone a working
/// key. The prefix is kept so the UI can show which key is which without ever
/// being able to reproduce it.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  /// SHA-256 of the full key.
  keyHash    String    @unique
  /// First 12 chars, for display only.
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  /// Requests served this UTC day, reset lazily on first use.
  callsToday Int       @default(0)
  callsDay   String    @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}
