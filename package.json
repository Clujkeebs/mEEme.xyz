{
  "name": "meeme-xyz",
  "version": "1.0.0",
  "private": true,
  "description": "mEEme.xyz — the Exit Engine. Coiled Supply Analysis for memecoin traders.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start -p ${PORT:-3000}",
