# ─────────────────────────────────────────────────────────────────────────────
# mEEme.xyz — environment
#
# Nothing here is required to see the app work. With zero keys set, mEEme runs
# in DEMO mode: the engine is real, the data is deterministic synthetic, and
# every read is labelled as such and excluded from the public track record.
# Add keys to make it live.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required in production) ────────────────────────────────────────────
# Local dev: file:./dev.db      Production: postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"
# Public origin. No trailing slash.
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── Google login (optional — without it, sign-in is disabled and the app runs
#    read-only in demo mode) ──────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Admin (optional — without it, /admin/promo redirects home for everyone) ──
# Comma-separated emails allowed to create and manage promo codes at
# /admin/promo. Must match the email the account signed in with via Google.
ADMIN_EMAILS=""

# ── Market data (optional — each provider that is missing degrades the read
#    rather than breaking it; /api/diagnostics tells you exactly what is live) ─
# Helius: helius.dev — free tier covers holder balances + transaction history.
# This is the single highest-value key: without it there is no cost basis and
# therefore no coil, only structural analysis.
HELIUS_API_KEY=""
# Birdeye: birdeye.so — OPTIONAL. GeckoTerminal already supplies price history
# with no key, so this is a rate-limit upgrade rather than a requirement. Worth
# adding once scan volume grows, since the keyless tier is ~30 req/min.
BIRDEYE_API_KEY=""
# GeckoTerminal needs no key. Set only to override the host.
GECKOTERMINAL_BASE_URL="https://api.geckoterminal.com/api/v2"
# Solana Tracker: solanatracker.io — alternative trade history source.
SOLANA_TRACKER_API_KEY=""
# DexScreener and RugCheck need no key. Set these only to override the hosts.
DEXSCREENER_BASE_URL="https://api.dexscreener.com"
RUGCHECK_BASE_URL="https://api.rugcheck.xyz"

# ── Stripe (optional — without it, everyone is on the free tier) ─────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Create two recurring prices in the Stripe dashboard and paste their IDs.
STRIPE_PRICE_DEGEN=""   # $4.99/mo
STRIPE_PRICE_APEX=""    # $19.99/mo

# ── Alert delivery (this is what the paid tiers actually sell) ──────────────
# Without at least one of these, alerts are written to the database and nobody
# ever sees them — which makes "the engine watches while you sleep" untrue.
#
# Telegram: message @BotFather, /newbot, paste the token here and the bot's
# @name below. Then POST /api/telegram/setup once to register the webhook.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Generate with: openssl rand -hex 32. Telegram sends it back on every update.
TELEGRAM_WEBHOOK_SECRET=""

# Email fallback via resend.com (free tier covers 3k/month).
RESEND_API_KEY=""
ALERT_FROM_EMAIL="mEEme <alerts@meeme.xyz>"

# ── Cron protection (required once deployed) ────────────────────────────────
# Vercel Cron sends this as `Authorization: Bearer <secret>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ── Flags ───────────────────────────────────────────────────────────────────
# Force demo data even when provider keys exist. Useful for screenshots.
MEEME_FORCE_DEMO="false"
